/* ============================================================
   StudyRoom — Dark Theme (default)
   Accent:  #6C63FF  (purple)
   Success: #4CAF50  (green)
   Warning: #FF9800  (orange)
   Danger:  #F44336  (red)
   ============================================================ */

/* ── Global ─────────────────────────────────────────────────── */
QWidget {
    background-color: #0F1117;
    color: #E8EAF6;
    /* اضافه کردن فونت‌های استاندارد فارسی برای ظاهر بهتر */
    font-family: "Vazir", "Vazirmatn", "Segoe UI", "Tahoma", sans-serif;
    font-size: 14px;
    border: none;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #0F1117;
}

/* ── Cards / Panels ─────────────────────────────────────────── */
QFrame#card, QGroupBox {
    background-color: #1A1D27;
    border: 1px solid #2D3245;
    border-radius: 8px;
    padding: 12px;
}
QGroupBox::title {
    color: #9E9E9E;
    font-size: 12px;
    letter-spacing: 1px;
    subcontrol-origin: margin;
    right: 12px; /* تغییر به right به دلیل راست‌چین شدن برنامه */
    top: 6px;
}

/* ── Buttons ────────────────────────────────────────────────── */
QPushButton {
    background-color: #2D3245;
    color: #E8EAF6;
    border: 1px solid #3D4265;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    min-height: 32px;
}
QPushButton:hover {
    background-color: #3D4265;
    border-color: #6C63FF;
}
QPushButton:pressed {
    background-color: #6C63FF;
    border-color: #6C63FF;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #1A1D27;
    color: #555770;
    border-color: #2D3245;
}

/* Primary accent button */
QPushButton#primaryBtn, QPushButton[role="primary"] {
    background-color: #6C63FF;
    color: #FFFFFF;
    border: none;
}
QPushButton#primaryBtn:hover, QPushButton[role="primary"]:hover {
    background-color: #7C73FF;
}
QPushButton#primaryBtn:pressed, QPushButton[role="primary"]:pressed {
    background-color: #5C53EF;
}

/* Danger button */
QPushButton[role="danger"] {
    background-color: transparent;
    color: #F44336;
    border: 1px solid #F44336;
}
QPushButton[role="danger"]:hover {
    background-color: #F44336;
    color: #FFFFFF;
}

/* Icon-only round button */
QPushButton#iconBtn {
    background-color: transparent;
    border: none;
    border-radius: 18px; /* تغییر گردی دکمه */
    padding: 4px;
    min-width: 36px;  /* افزایش فضا برای جلوگیری از فشرده شدن اموجی‌ها */
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    font-size: 16px;  /* بزرگتر کردن سایز آیکون/اموجی */
}
QPushButton#iconBtn:hover {
    background-color: #2D3245;
}

/* Sidebar Navigation Button */
QPushButton#navBtn {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    font-size: 20px; /* سایز بزرگتر برای آیکون‌های منوی کناری */
}
QPushButton#navBtn:hover {
    background-color: #2D3245;
}

/* ── Labels ─────────────────────────────────────────────────── */
QLabel {
    color: #E8EAF6;
    background-color: transparent;
}
QLabel#timerLabel {
    color: #FFFFFF;
    font-size: 64px;
    font-weight: 700;
    letter-spacing: 2px;
    background-color: transparent;
}
QLabel#phaseLabel {
    color: #9E9E9E;
    font-size: 14px;
    background-color: transparent;
}
QLabel#statValue {
    color: #6C63FF;
    font-size: 24px;
    font-weight: 700;
    background-color: transparent;
}
QLabel#statCaption {
    color: #9E9E9E;
    font-size: 12px;
    background-color: transparent;
}
QLabel#sectionTitle {
    color: #E8EAF6;
    font-size: 16px;
    font-weight: 600;
    background-color: transparent;
}

/* ── Input fields ───────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #1A1D27;
    color: #E8EAF6;
    border: 1px solid #2D3245;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #6C63FF;
    min-height: 32px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #6C63FF;
}

/* ── Sliders ────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background-color: #2D3245;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #6C63FF;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin: -6px 0;
}
QSlider::sub-page:horizontal {
    background-color: #6C63FF;
    border-radius: 2px;
}
QSlider::groove:vertical {
    background-color: #2D3245;
    width: 6px;
    border-radius: 3px;
}
QSlider::handle:vertical {
    background-color: #6C63FF;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin: 0 -5px;
}
QSlider::add-page:vertical {
    background-color: #6C63FF; /* بخش پر شده‌ی ولوم صدا */
    border-radius: 3px;
}
QSlider::sub-page:vertical {
    background-color: #2D3245; /* بخش خالی ولوم صدا */
    border-radius: 3px;
}

/* ── Progress Bar ───────────────────────────────────────────── */
QProgressBar {
    background-color: #2D3245;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #6C63FF;
    border-radius: 4px;
}

/* ── Scroll Bars ────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #0F1117;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2D3245;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #6C63FF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #0F1117;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #2D3245;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #6C63FF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Dock Widgets ───────────────────────────────────────────── */
QDockWidget {
    color: #E8EAF6;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background-color: #1A1D27;
    padding: 6px 12px;
    font-weight: 600;
    font-size: 13px;
    border-bottom: 1px solid #2D3245;
}

/* ── Specific widget overrides ──────────────────────────────── */
QWidget#timerPanel {
    background-color: #1A1D27;
    border-radius: 16px;
    padding: 20px;
}
QWidget#channelCard {
    background-color: #1A1D27;
    border: 1px solid #2D3245;
    border-radius: 8px;
    padding: 8px;
}

QLabel#timerLabel[phase="work"]         { color: #4CAF50; }
QLabel#timerLabel[phase="short_break"]  { color: #FF9800; }
QLabel#timerLabel[phase="long_break"]   { color: #6C63FF; }
QLabel#timerLabel[phase="idle"]         { color: #E8EAF6; }